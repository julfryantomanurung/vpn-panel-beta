# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
TOKEN_SECRET=your-secret-key-here-change-this-in-production

# VPN Configuration (optional - will read from /root/domain if not set)
DOMAIN=vpn.example.com

# Database Configuration (if using MongoDB)
MONGODB_URI=mongodb://localhost:27017/vpn-panel

# Logging
LOG_LEVEL=info
